    "about.intro": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record offerings, track expenses, reconcile with the bank, and produce every report your church needs — all on your phone."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi lại dâng hiến, theo dõi chi phí, đối chiếu ngân hàng và tạo mọi báo cáo hội thánh cần — ngay trên điện thoại."
          }
        }
      }
    },
